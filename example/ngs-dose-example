#!/bin/sh
# ngs-dose-example DIR - copy the 1000 Genomes cohort scripts out of the container image.
# The scripts submit SLURM jobs, so they run on the host; with SIF set, every tool they call
# (engine, ngsdose, aria2c) and the resource bundle come from the image:
#   apptainer exec ngs-dose.sif ngs-dose-example $PWD/dose1000G
#   cd dose1000G && export SIF=/path/to/ngs-dose.sif WORK_DIR=/scratch/$USER/ngs_dose_1000G && bash 00_setup.sh
set -e
d="${1:?usage: ngs-dose-example DIR}"
src="${NGSDOSE_EXAMPLE_SRC:-/opt/ngs-dose/example/1000G}"
mkdir -p "$d"
cp -r "$src"/. "$d"/
chmod -R u+w "$d"
echo "cohort scripts copied to $d (see README.md there); run them with SIF set to this image"
